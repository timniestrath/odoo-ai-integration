# Copy this file to ".env" and fill in your real values
# Do NOT commit .env itself to git!

# Odoo credentials (set during initial setup in the browser)
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USERNAME=admin
ODOO_PASSWORD=admin

# AI API (e.g. Anthropic or OpenAI) - for step 2 (function calling)
ANTHROPIC_API_KEY=
