# Kopiere diese Datei zu ".env" und trage deine echten Werte ein
# .env selbst NICHT in Git committen!

# Odoo-Zugangsdaten (nach Ersteinrichtung im Browser vergeben)
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USERNAME=admin
ODOO_PASSWORD=admin

# KI-API (z.B. Anthropic oder OpenAI) - für Schritt 2 (Function Calling)
ANTHROPIC_API_KEY=
